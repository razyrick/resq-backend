# Copy to .env and fill in real values (never commit .env).
# mysql / MariaDB
DB_HOST=localhost
DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password

# URL path prefix if the API is not served from domain root (often empty)
BASEPATH=

# Brevo (Sendinblue) transactional email — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Your app name"

# Public base URL of this backend (used in auth/verification links)
APP_BASE_URL=https://your-backend.example

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTO_REGISTER=false
